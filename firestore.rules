rules_version = '2';

// Reconstructed on 2026-09-23 after a scoped rules file (covering only the
// new product-review/view-tracking collections) was deployed and
// overwrote the project's actual production rules, breaking access to
// every other collection (users, orders, chats, categories, promos,
// products, settings) for the live app. This file restores full coverage
// based on how both apps (flutter_web_willbefore admin site and
// flutter_willbefore2000 customer app) actually read/write Firestore,
// reconstructed from the codebase since the prior ruleset content was not
// recoverable from this session. Please validate the critical flows
// (login, browsing, cart, checkout, admin product/order management,
// support chat) after deploy and report anything still broken so the
// specific rule can be corrected.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /cartItems/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
      }
    }

    // --- Orders (top-level, admin-queryable copy) ---
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Products (public catalog, admin-managed) ---
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Per-user view idempotency marker - client can only create it once
      // (create fails if it already exists), never read/updated/deleted.
      // A Cloud Function trigger off its creation increments the sharded
      // view counter.
      match /viewEvents/{userId} {
        allow create: if isOwner(userId) &&
          !exists(/databases/$(database)/documents/products/$(productId)/viewEvents/$(userId));
        allow read, update, delete: if false;
      }

      // Sharded engagement counters - written only by Cloud Functions via
      // the Admin SDK, which bypasses rules entirely.
      match /counterShards/{shardId} {
        allow read, write: if false;
      }
    }

    // --- Product reviews ---
    // Doc ID is deterministic: "{userId}_{productId}", one review per user
    // per product. Publicly readable; only the owning user may create or
    // edit their own review.
    match /productReviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && reviewId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Categories & promos (public catalog metadata, admin-managed) ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- App-wide settings (e.g. shipping/warehouse config) ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Support chat ---
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read, create: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid
            || isAdmin());
      }
    }
  }
}
